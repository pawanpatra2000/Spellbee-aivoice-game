[Unit]
Description=Spellbee AI Voice Game Frontend (React/Vite)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/Spellbee-aivoice-game/frontend
ExecStart=/usr/bin/npm run dev -- --host 0.0.0.0 --port 5173
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Environment variables
Environment="PATH=/root/Spellbee-aivoice-game/frontend/node_modules/.bin:/usr/local/bin:/usr/bin"
Environment="VITE_API_URL=http://localhost:8000"

[Install]
WantedBy=multi-user.target
